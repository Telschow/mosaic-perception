title: "Mosaic: A reproducible workbench for multi-sensor perception, object tracking and uncertainty"
version: 0.1.0
date-released: 2026-10-25
license: MIT
authors:
  - family-names: Telschow
    given-names: Telschow
repository-code: "https://github.com/Telschow/mosaic-perception"
